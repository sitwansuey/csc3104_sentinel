{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "demo-api",
    "namespace": "sentinel-admission-a957fc8f",
    "labels": {
      "app": "demo-api"
    },
    "annotations": {
      "example.com/owner": "platform"
    }
  },
  "spec": {
    "replicas": 0,
    "selector": {
      "matchLabels": {
        "app": "demo-api"
      }
    },
    "template": {
      "metadata": {
        "labels": {
          "app": "demo-api"
        }
      },
      "spec": {
        "automountServiceAccountToken": false,
        "containers": [
          {
            "name": "app",
            "image": "registry.k8s.io/pause:3.9",
            "resources": {
              "requests": {
                "cpu": "10m",
                "memory": "16Mi"
              },
              "limits": {
                "cpu": "50m",
                "memory": "32Mi"
              }
            }
          }
        ]
      }
    }
  }
}
