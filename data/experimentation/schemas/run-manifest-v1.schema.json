{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sentinel experiment run manifest v1",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "mode",
    "scenario_id",
    "started_at",
    "source_revision",
    "versions",
    "configuration",
    "recovery_enabled"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$"
    },
    "mode": {
      "const": "demo"
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "source_revision": {
      "type": "string",
      "minLength": 1
    },
    "versions": {
      "type": "object",
      "required": [
        "boutique",
        "chaos_mesh"
      ],
      "properties": {
        "boutique": {
          "type": "string",
          "minLength": 1
        },
        "chaos_mesh": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "configuration": {
      "type": "object",
      "required": [
        "traffic",
        "telemetry",
        "fault"
      ],
      "properties": {
        "traffic": {
          "type": "object"
        },
        "telemetry": {
          "type": "object"
        },
        "fault": {
          "type": "object"
        }
      }
    },
    "recovery_enabled": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
